{
  "name": "music-discovery-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "generate:api-types": "openapi-typescript ../docs/web-openapi.json -o src/api.generated.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run generate:api-types && npm run typecheck && vite build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
