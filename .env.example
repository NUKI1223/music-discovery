# Copy to .env in the project root. UI and CLI load it; process env takes precedence.
# Paste your OpenRouter key here. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
OPENROUTER_INPUT_USD_PER_MILLION=0.20
OPENROUTER_OUTPUT_USD_PER_MILLION=1.20
# Prices checked 2026-10-30. Local project uses $0.01/request and $0.10/day.
# Template stays disabled until explicitly configured; see docs/openrouter-costs.md.
MAX_COST_PER_REQUEST_USD=0
MAX_COST_PER_DAY_USD=0
# Optional per-account daily cap for the assistant (default: same as MAX_COST_PER_DAY_USD).
# MAX_COST_PER_ACCOUNT_DAY_USD=0.05
DISCOVERY_DB=runtime/discovery.sqlite3
DISCOVERY_CATALOG=data/unified/community-genres-v4/catalog.json
# Optional promoted safe JSON model artifact. Unvalidated genres use baseline.
DISCOVERY_MODEL_PATH=

# Input sizing: estimated tokens and serialized UTF-8 bytes are separate limits.
MAX_INPUT_TOKENS=16384
MAX_INPUT_BYTES=65536
